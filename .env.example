# URL de l'API Symfony (API Platform).
# En dev, LAISSER VIDE : le proxy Vite (vite.config.ts) route déjà /api → http://localhost:8000,
# ce qui garde le front et l'API sur la même origine (pas de CORS, cookies OK).
# Ne définir VITE_API_URL que pour attaquer directement une API distante.
# VITE_API_URL=http://localhost:8000

# Environnement (development | production)
NODE_ENV=development
